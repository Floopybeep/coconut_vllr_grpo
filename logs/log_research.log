  ---
  Change 2: Mini-batch loop body

  Replace from mb_new_outputs = parallel_model(...) through mb_loss.backward() (lines 825–844):

                      mb_new_outputs = parallel_model(input_embeds=mb_embeds)
                      mb_new_lp, _   = compute_log_probs(
                          mb_tok, mb_new_outputs, len_question, latent_id, tokenizer.eos_token_id
                      )

                      # Extract termination logits before deleting outputs.
                      # Shape: termination_logits is (mb_size, max_len, 2).
                      # Slice [len_question-1 : -1] selects the predictions for
                      # generated positions [len_question .. max_len-1].
                      mb_term_logits = mb_new_outputs.termination_logits[
                          :, len_question - 1 : -1, :
                      ].float()                                                  # (mb_size, gen_len, 2)
                      del mb_new_outputs

                      # --- Existing GRPO + KL loss ---
                      mb_log_ratio = mb_new_lp - mb_ref_lp
                      mb_ratio     = torch.exp(mb_log_ratio).clamp(min=1e-6, max=100.0)
                      mb_clipped   = torch.clamp(mb_ratio, 1.0 - configs.clip_ratio, 1.0 + configs.clip_ratio)

                      t1 = mb_ratio   * mb_adv.unsqueeze(-1)
                      t2 = mb_clipped * mb_adv.unsqueeze(-1)
                      mb_policy_loss = -torch.min(t1, t2)

                      mb_kl = mb_ratio - mb_log_ratio - 1.0

                      # --- Entropy regularisation on termination head ---
                      # Maximise entropy over {latent, text} at each generated position
                      # to prevent the termination head collapsing to always-latent or
                      # always-text. We add -beta*H to the loss (minimising -H = maximising H).
                      term_probs = F.softmax(mb_term_logits, dim=-1)             # (mb_size, gen_len, 2)
                      H = -(term_probs * torch.log(term_probs + 1e-8)).sum(-1)   # (mb_size, gen_len)
                      L_entropy = -(H * mb_ref_mask).sum() / total_nonmasked     # scalar; negative → maximise

                      # --- Reward-weighted termination imitation ---
                      # Cross-entropy between termination head outputs and the actual
                      # termination decisions that were taken during rollout, weighted by
                      # raw reward (clipped to ≥0 so we only imitate successful trajectories).
                      mb_term_labels = all_term_labels[mb_start:mb_end]          # (mb_size, gen_len)
                      mb_raw_rewards = all_rewards[mb_start:mb_end].clamp(min=0) # (mb_size,)

                      mb_term_ce = F.cross_entropy(
                          mb_term_logits.reshape(-1, 2),
                          mb_term_labels.reshape(-1),
                          reduction='none',
                      ).reshape(mb_term_labels.shape)                            # (mb_size, gen_len)

                      L_imitation = (
                          mb_term_ce * mb_ref_mask * mb_raw_rewards.unsqueeze(-1)
                      ).sum() / total_nonmasked                                   # scalar

                      # --- Combined loss ---
                      mb_total_loss = (
                          mb_policy_loss
                          + configs.kl_beta  * mb_kl
                          + imitation_beta   * L_imitation
                          + entropy_beta     * L_entropy
                      )
                      mb_loss = (mb_total_loss * mb_ref_mask).sum() / total_nonmasked

                      mb_loss.backward()
